# ---- Database -------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite database in PGLITE_DIR (zero setup). Only one
# process can open it: no separate `npm run worker`, and stop the app before `npm run db:seed`.
# For production use Postgres, e.g. Supabase: postgres://postgres:pw@db.xxx.supabase.co:5432/postgres
DATABASE_URL=
PGLITE_DIR=.data/pglite

# ---- App ------------------------------------------------------------------
# Public URL of the app (alert links). When it's reachable from the internet, use its https:// URL:
# the session cookie is then always marked Secure.
APP_URL=http://127.0.0.1:3000
# FlipWatch only answers requests addressed to localhost / 127.0.0.1 or the APP_URL host (this blocks websites
# from reaching it through DNS rebinding). Using it under another name too (LAN IP, second domain)? List them here,
# comma-separated, e.g. 192.168.1.50:3000,flipwatch.local
ALLOWED_HOSTS=
# Set to require a password to open the app (recommended when exposed to the internet).
APP_PASSWORD=
# Docker only: the container refuses to start without APP_PASSWORD unless this is true.
ALLOW_NO_PASSWORD=false
# Optional key for signing session cookies (e.g. `openssl rand -base64 32`). When empty, a random
# one is generated and stored in the database. Changing it logs every browser out.
SESSION_SECRET=
# Set to true only behind a reverse proxy that sets X-Forwarded-For (nginx, Caddy, Traefik…), so
# failed logins are limited per client. Otherwise all clients share one limit (10 per 5 minutes).
TRUST_PROXY=false
# inline (Next.js server polls) | external (run `npm run worker`, needs DATABASE_URL) | off
WORKER_MODE=inline
# How often the scheduler looks for due searches (ms).
SCHEDULER_TICK_MS=5000
# Time zone for follow-up dates ("today" / "overdue"). Defaults to the system's, which is UTC in Docker.
# TZ=America/Vancouver
# Protects GET/POST /api/cron/tick for serverless schedulers (Vercel Cron etc.)
CRON_SECRET=

# ---- Scraping -------------------------------------------------------------
# Floor for every search's poll interval; each marketplace also enforces its own (60 s or more).
MIN_POLL_INTERVAL_SEC=30
SCRAPER_TIMEOUT_MS=20000
SCRAPER_USER_AGENT=

# eBay Browse API (free developer account: https://developer.ebay.com)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=
# true = only items offered for local pickup near the location's postal code (default: whole country)
EBAY_LOCAL_PICKUP_ONLY=false
# true = also return auctions (auction-only listings have no price)
EBAY_INCLUDE_AUCTIONS=false

# Facebook Marketplace — opt-in, read README "Facebook Marketplace" first. Normally turned on and connected in
# the app (Settings → Facebook → Connect Facebook); these are only for setting it up by hand.
FACEBOOK_ENABLED=false
FACEBOOK_COOKIES=
# Optional extra accounts: searches are spread over all of them by FACEBOOK_ACCOUNT_SHARES (account 1,
# account 2, account 3), e.g. "35,65". Empty = equal shares. When Facebook rate-limits one, the others carry on.
FACEBOOK_COOKIES_2=
FACEBOOK_COOKIES_3=
FACEBOOK_ACCOUNT_SHARES=
# Most Facebook requests per hour across all accounts (page loads + search API calls), split by share.
# Scheduled searches may use two thirds of each account's part; the rest is kept for Deal Hunts and price
# checks. Too many gets an account's Marketplace search throttled.
FACEBOOK_MAX_REQUESTS_PER_HOUR=60

# ---- AI engine -------------------------------------------------------------
# Usually chosen in the app (first-run setup / Settings → AI); a choice made there wins over these.
# anthropic (ANTHROPIC_API_KEY) | openai (OPENAI_API_KEY) | claude-cli / codex-cli (Claude Code or Codex you
# installed and signed into on this computer; photos are not sent, usage counts against your own plan).
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model for the chosen engine; empty = its default (claude-haiku-4-5, gpt-5-mini, sonnet, Codex's own default).
AI_MODEL=
# How many AI requests run at the same time (listing evaluations, price checks, Deal Hunt picks). 1–16.
AI_CONCURRENCY=6
# Paths to the CLIs when they aren't found automatically.
CLAUDE_CLI_PATH=
CODEX_CLI_PATH=
# ---- Discord bot: manage searches with /search in Discord ------------------
# Bot token from https://discord.com/developers/applications (Bot → Reset Token). Invite the bot with the
# "bot" and "applications.commands" scopes; it registers /search and /searches in every server it's in.
DISCORD_BOT_TOKEN=
# Comma-separated Discord user ids allowed to use the commands. Empty = the owner of the server.
DISCORD_ALLOWED_USER_IDS=

# ---- Notifications --------------------------------------------------------
# Browser push: generate with `npx web-push generate-vapid-keys`
# (the public key is also read from NEXT_PUBLIC_VAPID_PUBLIC_KEY)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Email alerts, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=FlipWatch <alerts@example.com>
